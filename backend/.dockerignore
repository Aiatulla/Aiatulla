# Keep the build context small and keep local state out of the image.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Never copy real configuration into an image.
.env
.env.*
!.env.example

# Fixtures and cassettes are test data. The running service does not need them.
tests/
scripts/
