# Copy to backend/.env for local development. Never commit the real .env.

# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://repo_radar:local_dev_only@localhost:5433/repo_radar

DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Model access.
# Replay is the default and needs no key: tests and CI serve recorded cassettes,
# so a fresh clone runs the whole suite offline and for free.
# Set LLM_CASSETTE_MODE=record with a real key only when re-recording fixtures.
LLM_MODEL=gemini-2.0-flash
LLM_CASSETTE_MODE=replay
# GEMINI_API_KEY=

# Frontend. Copy to frontend/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8001
